# ── Google Classroom ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Paste the same full callback URL into "Authorized
# redirect URIs". Run `npm start` once and the Settings screen shows the exact
# URL for your port/host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <the origin you opened>/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:8790/api/auth/google/callback

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8790
# 0.0.0.0 lets your phone reach the dashboard over Wi-Fi.
HOST=0.0.0.0
# Optional public URL used for Discord links and OAuth on a deployed host.
# APP_ORIGIN=https://classroom.example.com
SYNC_INTERVAL_MINUTES=15

# ── AI briefings (optional — the app also ranks deadlines locally) ───────────
# Freebuff API keys: Account → Developer API. Groq and OpenAI-compatible
# endpoints work too; set AI_BASE_URL and AI_MODEL to match.
OPENAI_API_KEY=
# AI_BASE_URL=https://freebuff.com/api/v1/paid
# AI_MODEL=gpt-4o-mini

# ── Discord bot (optional) ───────────────────────────────────────────────────
# discord.com/developers → New Application → Bot → Reset Token
DISCORD_BOT_TOKEN=
# The channel where scheduled digests and new-assignment alerts are posted.
DISCORD_CHANNEL_ID=
# Optional server ID: registers slash commands instantly for that one server.
DISCORD_GUILD_ID=
# Daily digest time in 24h local time. Set to "off" to disable.
DISCORD_DIGEST_TIME=07:00
# Post an alert whenever a new assignment appears.
DISCORD_ALERTS=true
