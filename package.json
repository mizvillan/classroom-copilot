{
  "name": "classroom-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Google Classroom deadlines, ranked and briefed by AI, on the web, on your phone, and in Discord.",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test server/test/*.test.js",
    "check": "tsc --noEmit",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
